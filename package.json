{
  "name": "bloxwap.github.io",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "sync:hig": "node scripts/sync-hig.mjs",
    "check": "node scripts/check.mjs && node --test scripts/check.test.mjs && node scripts/sync-hig.mjs --check",
    "test:check": "node --test scripts/check.test.mjs",
    "drift": "node scripts/drift.mjs",
    "test:e2e": "playwright test",
    "og": "node scripts/og.mjs",
    "evidence": "node scripts/evidence.mjs",
    "build": "node scripts/sync-hig.mjs",
    "predev": "npm run build"
  },
  "devDependencies": {
    "@bloxwap/font": "0.1.2",
    "@bloxwap/hig-tokens": "0.1.0",
    "@playwright/test": "1.56.1"
  }
}
